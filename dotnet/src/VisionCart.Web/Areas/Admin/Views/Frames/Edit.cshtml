@using VisionCart.Application.Catalogue
@model FrameEditViewModel
@{
    var isNew = Model.Frame is null;
    ViewData["Title"] = isNew ? "New frame" : Model.Frame!.Name;
    var d = Model.Details;

    var reports = isNew
        ? []
        : Model.Frame!.Variants.Select(v => TryOnReadiness.Inspect(Model.Frame, v)).ToList();
    var blocked = reports.Count(r => !r.CanFitPhysically);
    var warned = reports.Count(r => r.CanFitPhysically && r.HasWarnings);
    var mirrorReady = Model.Frame?.Variants.FirstOrDefault(v => v.TryOnImageUrl is not null);
}

<p class="small"><a asp-action="Index">← Frames</a></p>
<div class="panel-head">
    <div>
        <h1>@(isNew ? "New frame" : Model.Frame!.Name)</h1>
        @if (!isNew)
        {
            <p class="frame-meta">
                <code>@Model.Frame!.Sku</code>
                <span class="chip">@Humanise.Value(Model.Frame.Status)</span>
                <span class="chip">@Model.Frame.Variants.Count colourway@(Model.Frame.Variants.Count == 1 ? "" : "s")</span>
                @if (blocked > 0)
                {
                    <span class="tryon-state is-blocked">@blocked cannot be tried on</span>
                }
                else if (warned > 0)
                {
                    <span class="tryon-state is-warning">@warned need attention</span>
                }
                else if (reports.Count > 0)
                {
                    <span class="tryon-state is-ready">Try-on ready</span>
                }
            </p>
        }
    </div>
    @if (!isNew)
    {
        <div class="admin-row-actions">
            <a class="btn btn-outline btn-small" asp-action="Detail" asp-route-id="@Model.Frame!.Id">All details</a>
            <a class="btn btn-outline btn-small" href="/frames/@Model.Frame.Slug" target="_blank" rel="noopener">View in shop &#8599;</a>
            @if (mirrorReady is not null)
            {
                <a class="btn btn-outline btn-small" href="/try-on?variant=@mirrorReady.Id" target="_blank" rel="noopener">Try it on &#8599;</a>
            }
            <form method="post" asp-action="Archive" asp-route-id="@Model.Frame.Id">
                <button class="btn btn-outline btn-small" type="submit">Archive</button>
            </form>
        </div>
    }
</div>

<form method="post" asp-action="Save" asp-route-id="@Model.Frame?.Id">
    <div class="admin-two-col">
        <div>
            <div class="panel">
                <h2>Basics</h2>
                <div class="form-grid">
                    <div class="full">
                        <label for="Name">Frame name</label>
                        <input class="field" id="Name" name="Name" value="@d.Name" required autofocus />
                    </div>
                    <div>
                        <label for="Sku">SKU</label>
                        <input class="field" id="Sku" name="Sku" value="@d.Sku" />
                        <p class="hint">Left blank, we'll generate one.</p>
                    </div>
                    <div>
                        <label for="Slug">URL slug</label>
                        <input class="field" id="Slug" name="Slug" value="@d.Slug" />
                        <p class="hint">Left blank, we'll build it from the name.</p>
                    </div>
                    <div>
                        <label for="BrandId">Brand</label>
                        <select id="BrandId" name="BrandId">
                            <option value="">No brand</option>
                            @foreach (var brand in Model.Brands)
                            {
                                <option value="@brand.Id" selected="@(d.BrandId == brand.Id)">@brand.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="Status">Status</label>
                        <select id="Status" name="Status">
                            @foreach (var s in ProductStatuses.All)
                            {
                                <option value="@s" selected="@(d.Status == s)">@Humanise.Value(s)</option>
                            }
                        </select>
                    </div>
                    <div class="full">
                        <label for="Description">Description</label>
                        <textarea class="field" id="Description" name="Description" rows="3"
                                  placeholder="How they wear, who they suit, what they're made of.">@d.Description</textarea>
                    </div>
                </div>
            </div>

            <div class="panel">
                <h2>Style</h2>
                <div class="form-grid three">
                    <div>
                        <label for="Shape">Shape</label>
                        <select id="Shape" name="Shape">
                            <option value="">—</option>
                            @foreach (var s in FrameShapes.All)
                            {
                                <option value="@s" selected="@(d.Shape == s)">@Humanise.Value(s)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="Material">Material</label>
                        <select id="Material" name="Material">
                            <option value="">—</option>
                            @foreach (var m in FrameMaterials.All)
                            {
                                <option value="@m" selected="@(d.Material == m)">@Humanise.Value(m)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="RimType">Rim</label>
                        <select id="RimType" name="RimType">
                            @foreach (var r in RimTypes.All)
                            {
                                <option value="@r" selected="@(d.RimType == r)">@Humanise.Value(r)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="Gender">Wearer</label>
                        <select id="Gender" name="Gender">
                            @foreach (var g in Genders.All)
                            {
                                <option value="@g" selected="@(d.Gender == g)">@Humanise.Value(g)</option>
                            }
                        </select>
                    </div>
                    <div class="full">
                        <label for="FaceShapes">Suits these face shapes</label>
                        <input class="field" id="FaceShapes" name="FaceShapes" value="@d.FaceShapes"
                               placeholder="round,oval,heart" />
                        <p class="hint">Comma separated. Used to recommend frames after a try-on measures the face.</p>
                    </div>
                </div>
            </div>

            <div class="panel">
                <h2>Fitting features</h2>
                <p class="hint" style="margin-top:0;">
                    What a dispenser reaches for when a frame nearly fits. These appear on the
                    product page with an explanation, so only tick what is actually true.
                </p>
                <div class="feature-grid">
                    @{
                        var chosen = d.FeatureCodes ?? [];
                    }
                    @foreach (var code in FrameFeatures.All)
                    {
                        <label class="checkline">
                            <input type="checkbox" name="FeatureCodes" value="@code"
                                   checked="@chosen.Contains(code)" />
                            <span>
                                <strong>@Humanise.Value(code)</strong>
                                <span class="hint">@FrameFeatures.Help.GetValueOrDefault(code)</span>
                            </span>
                        </label>
                    }
                </div>
            </div>

            <div class="panel">
                <h2>Measurements (mm)</h2>
                <p class="hint" style="margin-top:0;">
                    These are not spec-sheet decoration. The virtual try-on draws this frame at
                    its overall width, seats it on the nose by its lens height, and works out
                    decentration from the lens width and bridge. Wrong figures here produce a
                    frame that looks convincing and is the wrong size.
                </p>
                <div class="form-grid three">
                    <div><label for="LensWidthMm">Lens width</label><input class="field" id="LensWidthMm" name="LensWidthMm" inputmode="decimal" value="@d.LensWidthMm" /></div>
                    <div><label for="BridgeWidthMm">Bridge</label><input class="field" id="BridgeWidthMm" name="BridgeWidthMm" inputmode="decimal" value="@d.BridgeWidthMm" /></div>
                    <div><label for="TempleLengthMm">Temple</label><input class="field" id="TempleLengthMm" name="TempleLengthMm" inputmode="decimal" value="@d.TempleLengthMm" /></div>
                    <div><label for="LensHeightMm">Lens height</label><input class="field" id="LensHeightMm" name="LensHeightMm" inputmode="decimal" value="@d.LensHeightMm" /></div>
                    <div><label for="TotalWidthMm">Total width</label><input class="field" id="TotalWidthMm" name="TotalWidthMm" inputmode="decimal" value="@d.TotalWidthMm" /><p class="hint">Hinge to hinge — wider than two lenses and a bridge. Sets the size band.</p></div>
                    <div><label for="WeightGrams">Weight (g)</label><input class="field" id="WeightGrams" name="WeightGrams" inputmode="decimal" value="@d.WeightGrams" /></div>
                </div>
            </div>
        </div>

        <div>
            <div class="panel">
                <h2>Buying</h2>
                <p class="hint" style="margin-top:0;">
                    Where this frame comes from, so a reorder can start from the product rather
                    than the ledger.
                </p>
                <div class="form-grid">
                    <div class="full">
                        <label for="VendorId">Vendor</label>
                        <select id="VendorId" name="VendorId">
                            <option value="">No vendor</option>
                            @foreach (var vendor in Model.Vendors)
                            {
                                <option value="@vendor.Id" selected="@(d.VendorId == vendor.Id)">
                                    @vendor.Name@(vendor.IsActive ? "" : " (retired)")
                                </option>
                            }
                        </select>
                        <p class="hint"><a asp-controller="Vendors" asp-action="Index">Manage vendors</a></p>
                    </div>
                    <div>
                        <label for="VendorProductCode">Their code for it</label>
                        <input class="field" id="VendorProductCode" name="VendorProductCode"
                               value="@d.VendorProductCode" />
                    </div>
                    <div>
                        <label for="LastCost">Last paid</label>
                        <input class="field" id="LastCost" name="LastCost" inputmode="decimal"
                               value="@d.LastCost" />
                        <p class="hint">What the last delivery cost, per frame.</p>
                    </div>
                    <div class="full">
                        <label for="PromotionGrade">Promotion grade</label>
                        <select id="PromotionGrade" name="PromotionGrade">
                            <option value="">Not graded</option>
                            @foreach (var grade in PromotionGrades.All)
                            {
                                <option value="@grade" selected="@(d.PromotionGrade == grade)">@grade</option>
                            }
                        </select>
                        <p class="hint">How this practice sorts its stock: A moves, C does not.</p>
                    </div>
                </div>
            </div>

            <div class="panel">
                <h2>Price &amp; rules</h2>
                <div class="form-grid">
                    <div>
                        <label for="Price">Frame price</label>
                        <input class="field" id="Price" name="Price" inputmode="decimal" value="@d.Price" required />
                    </div>
                    <div>
                        <label for="CompareAt">Was price</label>
                        <input class="field" id="CompareAt" name="CompareAt" inputmode="decimal" value="@d.CompareAt" />
                        <p class="hint">Shows a strikethrough.</p>
                    </div>
                    <div class="full">
                        <label for="Cost">Cost to us</label>
                        <input class="field" id="Cost" name="Cost" inputmode="decimal" value="@d.Cost" />
                        <p class="hint">Internal only. Never shown to a customer.</p>
                    </div>
                    <label class="checkline full">
                        <input type="checkbox" name="IsFeatured" value="true" checked="@d.IsFeatured" />
                        <span>Feature on the home page</span>
                    </label>
                    <label class="checkline full">
                        <input type="checkbox" name="AllowFrameOnly" value="true" checked="@d.AllowFrameOnly" />
                        <span>Can be bought without lenses</span>
                    </label>
                    <label class="checkline full">
                        <input type="checkbox" name="RequiresPrescription" value="true" checked="@d.RequiresPrescription" />
                        <span>Prescription lenses only</span>
                    </label>
                    <div class="full">
                        <label for="Position">Sort order</label>
                        <input class="field" id="Position" name="Position" type="number" value="@d.Position" />
                    </div>
                </div>
            </div>

            <div class="panel">
                <h2>Collections</h2>
                @foreach (var category in Model.Categories)
                {
                    <label class="checkline" style="margin-bottom:6px;">
                        <input type="checkbox" name="categoryIds" value="@category.Id"
                               checked="@Model.SelectedCategoryIds.Contains(category.Id)" />
                        <span>@category.Name</span>
                    </label>
                }
            </div>

            <div class="panel">
                <h2>Search listing</h2>
                <label for="MetaTitle" class="field-label">Page title</label>
                <input class="field" id="MetaTitle" name="MetaTitle" value="@d.MetaTitle" />
                <label for="MetaDesc" class="field-label" style="margin-top:8px;">Meta description</label>
                <input class="field" id="MetaDesc" name="MetaDesc" value="@d.MetaDesc" />
            </div>

            <button class="btn btn-primary btn-block" type="submit">Save frame</button>
        </div>
    </div>
</form>

@if (!isNew)
{
    <div class="panel">
        <h2>Colourways</h2>
        <p class="hint" style="margin-top:0;">Stock, price and try-on calibration live here.</p>

        @foreach (var variant in Model.Frame!.Variants)
        {
            <div style="border-top:1px solid var(--ink-100);padding-top:14px;margin-top:14px;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <span class="swatch" style="background:@(variant.ColorHex ?? "#ccc");width:20px;height:20px;"></span>
                        <div>
                            <strong>@variant.ColorName</strong><br />
                            <code class="muted small">@variant.Sku · @variant.StockQty in stock</code>
                        </div>
                    </div>
                    <div style="display:flex;gap:8px;align-items:center;">
                        @if (variant.TryOnImageUrl is not null)
                        {
                            <span class="chip chip-paid">Try-on ready</span>
                        }
                        else
                        {
                            <span class="chip chip-pending">No try-on artwork</span>
                        }
                        <button class="btn btn-outline btn-small" type="button" data-edit-toggle="v-@variant.Id">Edit</button>
                    </div>
                </div>

                <div data-edit-panel="v-@variant.Id" hidden style="margin-top:12px;">
                    <form method="post" asp-action="SaveVariant" asp-route-id="@Model.Frame.Id"
                          asp-route-variantId="@variant.Id">
                        <div class="form-grid three">
                            <div><label>Colour name</label><input class="field" name="ColorName" value="@variant.ColorName" required /></div>
                            <div><label>Swatch hex</label><input class="field" name="ColorHex" value="@variant.ColorHex" /></div>
                            <div><label>SKU</label><input class="field" name="Sku" value="@variant.Sku" /></div>
                            <div><label>Barcode</label><input class="field" name="Barcode" value="@variant.Barcode" /></div>
                            <div><label>Price override</label><input class="field" name="PriceOverride" inputmode="decimal"
                                     value="@(variant.PriceMinor is { } p ? Money.FromMinor(p, "PKR") : null)" /></div>
                            <div><label>In stock</label><input class="field" name="StockQty" type="number" value="@variant.StockQty" /></div>
                            <div><label>Warn at</label><input class="field" name="LowStockAt" type="number" value="@variant.LowStockAt" /></div>
                            <div><label>Sort order</label><input class="field" name="Position" type="number" value="@variant.Position" /></div>
                            <label class="checkline"><input type="checkbox" name="IsActive" value="true" checked="@variant.IsActive" /><span>Show in the shop</span></label>
                        </div>

                        <h4 class="location-heading">Where it sits</h4>
                        <div class="form-grid four">
                            <div><label>Aisle</label><input class="field" name="Aisle" value="@variant.Aisle" /></div>
                            <div><label>Shelf</label><input class="field" name="Shelf" value="@variant.Shelf" /></div>
                            <div><label>Row</label><input class="field" name="ShelfRow" value="@variant.ShelfRow" /></div>
                            <div><label>Bin</label><input class="field" name="Bin" value="@variant.Bin" /></div>
                        </div>
                        <button class="btn btn-primary btn-small" style="margin-top:10px;" type="submit">Save colourway</button>
                    </form>

                    <div style="border-top:1px solid var(--ink-100);margin-top:14px;padding-top:12px;">
                        <h3 style="font-size:14px;margin:0 0 4px;">Virtual try-on</h3>
                        <p class="hint" style="margin-top:0;">
                            The mirror draws this frame at its recorded width in millimetres, which
                            needs the artwork marked up: where the lenses are, and where the frame
                            front starts and ends. That is done on the picture itself, not here.
                        </p>
                        <p class="hint" style="margin:0;">
                            @if (variant.TryOnImageUrl is null)
                            {
                                <text>No artwork yet.</text>
                            }
                            else
                            {
                                <text>Artwork: <code>@variant.TryOnImageUrl</code></text>
                            }
                        </p>
                        @{
                            var report = TryOnReadiness.Inspect(Model.Frame!, variant);
                        }
                        @if (report.Issues.Count > 0)
                        {
                            <ul class="calibrate-issues" style="margin-top:10px;">
                                @foreach (var issue in report.Issues)
                                {
                                    <li class="is-@issue.Severity.ToString().ToLowerInvariant()">@issue.Message</li>
                                }
                            </ul>
                        }
                        <p style="margin:10px 0 0;display:flex;gap:8px;flex-wrap:wrap;">
                            <a class="btn btn-primary btn-small"
                               asp-action="Calibrate" asp-route-id="@Model.Frame.Id" asp-route-variantId="@variant.Id">
                                Calibrate the artwork
                            </a>
                            @if (variant.TryOnImageUrl is not null)
                            {
                                <a class="btn btn-outline btn-small"
                                   href="/try-on?variant=@variant.Id" target="_blank" rel="noopener">Preview in the mirror &#8599;</a>
                            }
                        </p>
                    </div>
                </div>
            </div>
        }

        <div style="border-top:1px solid var(--ink-100);padding-top:14px;margin-top:14px;">
            <button class="btn btn-outline btn-small" type="button" data-edit-toggle="v-new">Add a colourway</button>
            <div data-edit-panel="v-new" hidden style="margin-top:12px;">
                <form method="post" asp-action="SaveVariant" asp-route-id="@Model.Frame.Id">
                    <div class="form-grid three">
                        <div><label>Colour name</label><input class="field" name="ColorName" required /></div>
                        <div><label>Swatch hex</label><input class="field" name="ColorHex" placeholder="#1b1b1f" /></div>
                        <div><label>SKU</label><input class="field" name="Sku" /></div>
                        <div><label>In stock</label><input class="field" name="StockQty" type="number" value="0" /></div>
                        <div><label>Warn at</label><input class="field" name="LowStockAt" type="number" value="3" /></div>
                        <div><label>Sort order</label><input class="field" name="Position" type="number" value="0" /></div>
                        <label class="checkline"><input type="checkbox" name="IsActive" value="true" checked /><span>Show in the shop</span></label>
                    </div>

                    <h4 class="location-heading">Where it sits</h4>
                    <div class="form-grid four">
                        <div><label>Aisle</label><input class="field" name="Aisle" /></div>
                        <div><label>Shelf</label><input class="field" name="Shelf" /></div>
                        <div><label>Row</label><input class="field" name="ShelfRow" /></div>
                        <div><label>Bin</label><input class="field" name="Bin" /></div>
                    </div>
                    <button class="btn btn-primary btn-small" style="margin-top:10px;" type="submit">Add colourway</button>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true" defer></script>
}
