@using Microsoft.Extensions.Options
@using VisionCart.Application.Catalogue
@model FrameListViewModel
@inject IOptions<StoreOptions> Store
@{
    ViewData["Title"] = "Frames";
    var store = Store.Value;
}

<div class="panel-head">
    <div>
        <h1>Frames</h1>
        <p class="muted">@Model.Results.Total frame@(Model.Results.Total == 1 ? "" : "s")</p>
    </div>
    <a class="btn btn-primary" asp-action="New">New frame</a>
</div>

<form method="get" class="filter-bar">
    <div>
        <label for="q">Search</label>
        <input class="field" type="text" id="q" name="q" value="@Model.Q" placeholder="Name or SKU" />
    </div>
    <div>
        <label for="status">Status</label>
        <select id="status" name="status">
            <option value="">Any status</option>
            @foreach (var s in ProductStatuses.All)
            {
                <option value="@s" selected="@(Model.Status == s)">@Humanise.Value(s)</option>
            }
        </select>
    </div>
    <button class="btn btn-primary" type="submit">Filter</button>
    <a class="btn btn-outline" asp-action="Index">Clear</a>
</form>

@if (Model.Results.Items.Count == 0)
{
    <p class="alert alert-info">No frames match that search.</p>
}
else
{
    @* A table, because tabular data is genuinely what an administrator wants
       here — but only the columns a decision is made from. Everything else
       lives on the frame's own page. *@
    <div class="admin-table">
        <table>
            <thead>
                <tr>
                    <th>Frame</th>
                    <th>SKU</th>
                    <th class="num">Price</th>
                    <th class="num">Stock</th>
                    <th>Try-on</th>
                    <th>Status</th>
                    <th><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var frame in Model.Results.Items)
            {
                var stock = frame.Variants.Sum(v => v.StockQty);
                var reports = frame.Variants.Select(v => TryOnReadiness.Inspect(frame, v)).ToList();
                var blocked = reports.Count(r => !r.CanFitPhysically);
                var warned = reports.Count(r => r.CanFitPhysically && r.HasWarnings);
                var lead = frame.Variants
                    .OrderBy(v => v.Position)
                    .FirstOrDefault(v => v.TryOnImageUrl != null);

                <tr>
                    <td>
                        <div class="admin-product">
                            @if (lead?.TryOnImageUrl is { } art)
                            {
                                <img src="@art" alt="" loading="lazy" width="56" height="24" />
                            }
                            <div>
                                <strong>@frame.Name</strong>
                                <span class="small muted">
                                    @(frame.Brand?.Name ?? "No brand")
                                    · @frame.Variants.Count colourway@(frame.Variants.Count == 1 ? "" : "s")
                                </span>
                            </div>
                        </div>
                    </td>
                    <td><code>@frame.Sku</code></td>
                    <td class="num">@Money.Format(frame.BasePriceMinor, store.Currency, store.CurrencySymbol)</td>
                    <td class="num">@stock</td>
                    <td>
                        @if (frame.Variants.Count == 0)
                        {
                            <span class="tryon-state is-blocked">No colourways</span>
                        }
                        else if (blocked > 0)
                        {
                            <span class="tryon-state is-blocked">@blocked of @frame.Variants.Count incomplete</span>
                        }
                        else if (warned > 0)
                        {
                            <span class="tryon-state is-warning">@warned need attention</span>
                        }
                        else
                        {
                            <span class="tryon-state is-ready">Ready</span>
                        }
                    </td>
                    <td><span class="chip">@Humanise.Value(frame.Status)</span></td>
                    <td class="admin-row-actions">
                        <a class="btn btn-outline btn-small" asp-action="Edit" asp-route-id="@frame.Id">Edit</a>
                        <a class="btn btn-quiet btn-small" asp-controller="Frames" asp-action="Detail"
                           asp-area="" asp-route-slug="@frame.Slug" target="_blank" rel="noopener">View</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Results.Pages > 1)
    {
        <nav class="pager">
            @if (Model.Results.HasPrevious)
            {
                <a class="btn btn-outline btn-small" href="@Url.Action("Index", new { q = Model.Q, status = Model.Status, page = Model.Results.Page - 1 })">← Previous</a>
            }
            <span class="small muted">Page @Model.Results.Page of @Model.Results.Pages</span>
            @if (Model.Results.HasNext)
            {
                <a class="btn btn-outline btn-small" href="@Url.Action("Index", new { q = Model.Q, status = Model.Status, page = Model.Results.Page + 1 })">Next →</a>
            }
        </nav>
    }
}
