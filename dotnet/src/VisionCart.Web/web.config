<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for shared hosting (myASP.NET and equivalents).

  `dotnet publish` generates a minimal web.config if none exists. This file
  replaces it, because the generated one carries none of the hardening below and
  a shared host gives you no other place to put it: there is no access to
  applicationHost.config, and no way to run appcmd.

  The publish step fills in `processPath` and `arguments` to match the built
  output — a RID-specific publish produces an apphost .exe and needs no
  arguments, while a portable one runs `dotnet .\VisionCart.Web.dll`. Leaving
  them empty here lets the SDK write whichever is correct; hardcoding the
  portable form alongside an apphost passes the app a stray argument.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        hostingModel="inprocess" runs the application inside the IIS worker
        process. It is roughly twice as fast as out-of-process for this workload
        because requests skip a loopback HTTP hop, and on a shared host that hop
        is the single largest avoidable latency.

        stdoutLogEnabled stays false: it is unbuffered, it grows without limit,
        and on a quota-limited shared plan that eventually takes the site down.
        Application logging goes through the rolling file log instead. Turn this
        on only to diagnose a startup failure the app never survives long enough
        to record itself.
      -->
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering>
          <!--
            15 MB matches the uploader's own limit. IIS rejects an oversized
            body before it reaches the application, so the two must agree or a
            staff member gets an unexplained IIS error page instead of the
            uploader's message.
          -->
          <requestLimits maxAllowedContentLength="15728640" />

          <hiddenSegments>
            <add segment="logs" />
            <add segment="App_Data" />
          </hiddenSegments>

          <fileExtensions>
            <!-- Nothing here should ever be reachable over HTTP. -->
            <add fileExtension=".config" allowed="false" />
            <add fileExtension=".json" allowed="false" />
            <add fileExtension=".cs" allowed="false" />
            <add fileExtension=".csproj" allowed="false" />
            <add fileExtension=".pdb" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!--
            IIS advertises its own version on every response. The application
            sets its security headers in middleware; these two can only be
            removed here, because IIS adds them after the pipeline has run.
          -->
          <remove name="X-Powered-By" />
          <remove name="Server" />
        </customHeaders>
      </httpProtocol>

      <staticContent>
        <!--
          The .task and .wasm types are unknown to IIS. Static file middleware
          maps them for in-process requests, but a request IIS answers directly
          would still 404 — and that failure is silent on the server and fatal
          in the browser: the try-on mirror simply never starts.
        -->
        <remove fileExtension=".wasm" />
        <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
        <remove fileExtension=".task" />
        <mimeMap fileExtension=".task" mimeType="application/octet-stream" />
        <remove fileExtension=".webp" />
        <mimeMap fileExtension=".webp" mimeType="image/webp" />
        <remove fileExtension=".mjs" />
        <mimeMap fileExtension=".mjs" mimeType="text/javascript" />

        <!-- Assets are fingerprinted with asp-append-version, so a year is safe. -->
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>

      <!--
        The face model and its WebAssembly runtime are ~35 MB and are served from
        this origin rather than a CDN, because the whole point of the try-on
        architecture is that the customer's face never leaves their machine.
        Compressing them on the way out roughly halves that, and the year-long
        cache header means a returning customer pays it once.
      -->
      <urlCompression doStaticCompression="true" doDynamicCompression="false" />

      <httpErrors existingResponse="PassThrough" />

    </system.webServer>
  </location>
</configuration>
