<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for shared hosting (myASP.NET and equivalents).

  `dotnet publish` generates a minimal web.config if none exists. This file
  replaces it, because the generated one carries none of the hardening below and
  a shared host gives you no other place to put it: there is no access to
  applicationHost.config, and no way to run appcmd.

  The publish step fills in `processPath` and `arguments` to match the built
  output — a RID-specific publish produces an apphost .exe and needs no
  arguments, while a portable one runs `dotnet .\VisionCart.Web.dll`. Leaving
  them empty here lets the SDK write whichever is correct; hardcoding the
  portable form alongside an apphost passes the app a stray argument.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        hostingModel is "outofprocess" because IIS permits only ONE in-process
        ASP.NET Core application per application pool, and shared hosts routinely
        put every one of your sites in the same pool. In-process is roughly twice
        as fast for this workload — requests skip a loopback hop — so switch back
        the moment this application has a pool to itself. Until then it simply
        cannot start: the module refuses, and it surfaces as HTTP 500.30 with an
        empty stdout log and nothing in the Windows event log you can reach,
        which is a genuinely awful thing to debug. See docs/07-deployment.md §8.

        stdoutLogEnabled stays false: it is unbuffered, it grows without limit,
        and on a quota-limited shared plan that eventually takes the site down.
        Application logging goes through the rolling file log instead. Turn this
        on only to diagnose a startup failure the app never survives long enough
        to record itself.
      -->
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!--
        `<security><requestFiltering>` used to live here: a 15 MB request limit,
        hidden segments for `logs` and `App_Data`, and a deny list for `.config`,
        `.json`, `.cs`, `.csproj` and `.pdb`.

        It is gone because myASP.NET LOCKS that section, and a locked section
        does not fail quietly. IIS rejects the whole file before any handler
        runs, so the site answers a bare `500` with `Content-Length: 0`, no
        sub-status, no stdout log and no ANCM debug log — every diagnostic that
        would normally tell you what happened is downstream of the thing that
        failed. It looks exactly like an application that cannot start, and it
        sends you reading startup code for hours. If you ever see that triad,
        suspect a locked config section before anything else, and bisect this
        file by deleting sections until the site answers.

        `httpProtocol`, `staticContent`, `urlCompression` and `httpErrors` were
        checked one round at a time against the live host and are all accepted;
        only `security` is refused. A different host may draw the line
        elsewhere.

        Almost nothing is lost. The module owns every path (`path="*"`), so IIS
        never serves a file itself: `appsettings*.json`, `web.config`, the DLLs
        and `logs` are unreachable over HTTP whatever request filtering says,
        and the uploader enforces its own 15 MB limit in the application. What
        actually goes is a second line of defence, not the first.
      -->

      <httpProtocol>
        <customHeaders>
          <!--
            IIS advertises its own version on every response. The application
            sets its security headers in middleware; these two can only be
            removed here, because IIS adds them after the pipeline has run.
          -->
          <remove name="X-Powered-By" />
          <remove name="Server" />
        </customHeaders>
      </httpProtocol>

      <staticContent>
        <!--
          The .task and .wasm types are unknown to IIS. Static file middleware
          maps them for in-process requests, but a request IIS answers directly
          would still 404 — and that failure is silent on the server and fatal
          in the browser: the try-on mirror simply never starts.
        -->
        <remove fileExtension=".wasm" />
        <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
        <remove fileExtension=".task" />
        <mimeMap fileExtension=".task" mimeType="application/octet-stream" />
        <remove fileExtension=".webp" />
        <mimeMap fileExtension=".webp" mimeType="image/webp" />
        <remove fileExtension=".mjs" />
        <mimeMap fileExtension=".mjs" mimeType="text/javascript" />

        <!-- Assets are fingerprinted with asp-append-version, so a year is safe. -->
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>

      <!--
        The face model and its WebAssembly runtime are ~35 MB and are served from
        this origin rather than a CDN, because the whole point of the try-on
        architecture is that the customer's face never leaves their machine.
        Compressing them on the way out roughly halves that, and the year-long
        cache header means a returning customer pays it once.
      -->
      <urlCompression doStaticCompression="true" doDynamicCompression="false" />

      <httpErrors existingResponse="PassThrough" />

    </system.webServer>
  </location>
</configuration>
