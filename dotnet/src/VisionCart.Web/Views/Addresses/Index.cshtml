@model IReadOnlyList<Address>
@{
    ViewData["Title"] = "Your addresses";
}

<div class="page-head">
    <div>
        <h1>Your addresses</h1>
        <p>Where we deliver. The default is selected for you at checkout.</p>
    </div>
</div>
@if (TempData["AccountOk"] is string ok)
{
    <p class="alert alert-ok">@ok</p>
}
@if (TempData["AccountError"] is string error)
{
    <p class="alert alert-error" role="alert">@error</p>
}

@if (Model.Count == 0)
{
    <div class="shop-empty">
        <span class="shop-empty-art">@Icons.Svg("truck")</span>
        <h2>No saved addresses</h2>
        <p>Save an address and it will be filled in for you at checkout — and set as the default for future orders.</p>
        <a class="btn btn-primary" asp-action="New">@Icons.Svg("plus") Add an address</a>
    </div>
}
else
{
    <div class="address-grid">
        @foreach (var address in Model)
        {
            <div class="address-card @(address.IsDefault ? "is-default" : "")">
                @if (address.IsDefault)
                {
                    <span class="chip chip-paid">Default</span>
                }
                @if (!string.IsNullOrWhiteSpace(address.Label))
                {
                    <p class="address-label">@address.Label</p>
                }
                <p class="address-lines">
                    <strong>@address.FullName</strong><br />
                    @address.Line1<br />
                    @if (!string.IsNullOrWhiteSpace(address.Line2))
                    {
                        @address.Line2<br />
                    }
                    @address.City@(string.IsNullOrWhiteSpace(address.State) ? "" : ", " + address.State)
                    @address.PostalCode<br />
                    @address.Country
                    @if (!string.IsNullOrWhiteSpace(address.Phone))
                    {
                        <br />
                        <span class="muted">@address.Phone</span>
                    }
                </p>
                <div class="address-actions">
                    <a class="btn btn-outline btn-small" asp-action="Edit" asp-route-id="@address.Id">Edit</a>
                    @if (!address.IsDefault)
                    {
                        <form method="post" asp-action="MakeDefault" asp-route-id="@address.Id">
                            <button class="btn btn-outline btn-small" type="submit">Make default</button>
                        </form>
                    }
                    <form method="post" asp-action="Delete" asp-route-id="@address.Id">
                        <button class="btn btn-outline btn-small btn-danger" type="submit">Remove</button>
                    </form>
                </div>
            </div>
        }
    </div>
}

<p class="mt-3">
    <a class="btn btn-primary" asp-action="New">Add an address</a>
    <a class="btn btn-outline" asp-controller="Account" asp-action="Index">Back to your account</a>
</p>
