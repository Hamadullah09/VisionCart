@using Microsoft.Extensions.Options
@model CartView
@inject IOptions<StoreOptions> Store
@{
    ViewData["Title"] = "Your cart";
    var store = Store.Value;
    string M(int minor) => Money.Format(minor, store.Currency, store.CurrencySymbol);
    var count = Model.Lines.Sum(l => l.Qty);
}

<div class="page-head">
    <div>
        <h1>Your cart</h1>
        @if (!Model.IsEmpty)
        {
            <p>@count item@(count == 1 ? "" : "s"). Prices are worked out on our side every time this page loads, so nothing here can drift.</p>
        }
    </div>
</div>

@if (Model.IsEmpty)
{
    <div class="shop-empty">
        <span class="shop-empty-art">@Icons.Svg("orders")</span>
        <h2>Your cart is empty</h2>
        <p>Nothing in here yet. Try a frame on first if you are not sure — it is quicker than guessing from a photograph.</p>
        <div class="hero-actions">
            <a class="btn btn-primary" asp-controller="Frames" asp-action="Index">Browse frames</a>
            <a class="btn btn-outline" href="/try-on">Try a pair on</a>
        </div>
    </div>
}
else
{
    @foreach (var warning in Model.Warnings.Distinct())
    {
        <p class="alert alert-warn">@Icons.Svg("warning")<span>@warning</span></p>
    }

    @if (Model.PromoError is { } promoError)
    {
        <p class="alert alert-error">@Icons.Svg("warning")<span>@promoError</span></p>
    }

    <div class="cart-layout">
        <div>
            @foreach (var line in Model.Lines)
            {
                <div class="cart-line">
                    <div class="cart-thumb">
                        @if (line.ImageUrl is not null)
                        {
                            <img src="@line.ImageUrl" alt="@line.Title" loading="lazy" />
                        }
                    </div>

                    <div>
                        <h3>@line.Title</h3>
                        <p class="cart-meta">@line.LensSummary</p>
                        <p class="cart-sku">@line.Sku</p>

                        <div class="cart-line-actions">
                            @* One form, two submit buttons carrying the new
                               quantity — unchanged from before, so a cart still
                               works with scripting off. *@
                            <form method="post" asp-controller="Cart" asp-action="Update">
                                <input type="hidden" name="itemId" value="@line.ItemId" />
                                <span class="qty">
                                    <button type="submit" name="qty" value="@(line.Qty - 1)"
                                            aria-label="Decrease quantity of @line.Title">&minus;</button>
                                    <span class="qty-value" aria-live="polite">@line.Qty</span>
                                    <button type="submit" name="qty" value="@(line.Qty + 1)"
                                            aria-label="Increase quantity of @line.Title">+</button>
                                </span>
                            </form>
                            <form method="post" asp-controller="Cart" asp-action="Remove">
                                <input type="hidden" name="itemId" value="@line.ItemId" />
                                <button class="cart-remove" type="submit">Remove</button>
                            </form>
                        </div>
                    </div>

                    <div class="cart-price">@M(line.TotalMinor)</div>
                </div>
            }
        </div>

        <aside class="cart-aside">
            <div class="cart-summary">
                <h2>Summary</h2>

                <div class="totals-row"><span>Frames</span><span>@M(Model.Totals.SubtotalMinor)</span></div>
                @if (Model.Totals.LensTotalMinor > 0)
                {
                    <div class="totals-row"><span>Lenses</span><span>@M(Model.Totals.LensTotalMinor)</span></div>
                }
                @foreach (var promo in Model.Promotions)
                {
                    <div class="totals-row discount">
                        <span>@promo.Name</span>
                        <span>&minus; @M(promo.DiscountMinor)</span>
                    </div>
                }
                <div class="totals-row">
                    <span>Delivery</span>
                    <span>@(Model.Totals.ShippingMinor == 0 ? "Free" : M(Model.Totals.ShippingMinor))</span>
                </div>
                @if (Model.Totals.TaxMinor > 0)
                {
                    <div class="totals-row"><span>Tax</span><span>@M(Model.Totals.TaxMinor)</span></div>
                }
                <div class="totals-row grand"><span>Total</span><span>@M(Model.Totals.TotalMinor)</span></div>

                <a class="btn btn-primary btn-block" asp-controller="Checkout" asp-action="Index">Checkout</a>
                <a class="btn btn-outline btn-block" asp-controller="Frames" asp-action="Index">Keep shopping</a>

                <p class="cart-note">An optician checks every prescription before it reaches the lab.</p>
            </div>

            <div class="promo">
                <h3>Have a code?</h3>
                <form method="post" asp-controller="Cart" asp-action="Promo">
                    <div class="promo-row">
                        <label class="sr-only" for="code">Promotion code</label>
                        <input class="field" type="text" id="code" name="code" value="@Model.PromoCode"
                               placeholder="Promo code" autocomplete="off" />
                        <button class="btn btn-outline" type="submit">Apply</button>
                    </div>
                </form>

                @if (Model.PromoCode is not null)
                {
                    <div class="promo-applied">
                        <code>@Model.PromoCode</code>
                        <form method="post" asp-controller="Cart" asp-action="Promo">
                            <input type="hidden" name="code" value="" />
                            <button class="cart-remove" type="submit">Remove</button>
                        </form>
                    </div>
                }
            </div>
        </aside>
    </div>
}
