@using Microsoft.Extensions.Options
@model Order
@inject IOptions<StoreOptions> Store
@{
    ViewData["Title"] = $"Order {Model.OrderNo}";
    var store = Store.Value;
    string M(int minor) => Money.Format(minor, store.Currency, store.CurrencySymbol);

    // Where the order is, told as a journey rather than as three database
    // columns. Cancelled and refunded are not points on that journey, so they
    // get a plain statement instead of a track with a dot stuck in the middle.
    var journey = new (string Label, string Status)[]
    {
        ("Placed", OrderStatuses.Pending),
        ("Paid", OrderStatuses.Paid),
        ("In the lab", OrderStatuses.InLab),
        ("Shipped", OrderStatuses.Shipped),
        ("Delivered", OrderStatuses.Delivered),
    };
    var halted = Model.Status is OrderStatuses.Cancelled or OrderStatuses.Refunded;
    // "ready" sits between the lab and the courier; it belongs at the lab step.
    var effective = Model.Status == OrderStatuses.Ready ? OrderStatuses.InLab : Model.Status;
    var reached = Array.FindIndex(journey, s => s.Status == effective);
}

<div class="page-head">
    <div>
        <h1>Thank you — order @Model.OrderNo</h1>
        <p>Placed @Model.PlacedAt.ToString("d MMMM yyyy 'at' HH:mm")</p>
    </div>
    <span class="@StatusStyle.Chip(Model.PaymentStatus)">@Humanise.Value(Model.PaymentStatus)</span>
</div>

@if (halted)
{
    <div class="order-halted">
        @Icons.Svg("info")
        <p>This order is @Humanise.Value(Model.Status).ToLowerInvariant(). Nothing further will be made or shipped.</p>
    </div>
}
else
{
    <ol class="order-track">
        @for (var i = 0; i < journey.Length; i++)
        {
            var state = reached < 0 ? "" : i < reached ? "is-done" : i == reached ? "is-now" : "";
            <li class="order-step @state" aria-current="@(i == reached ? "step" : null)">@journey[i].Label</li>
        }
    </ol>
}

@if (Model.PaymentStatus == PaymentStatuses.Unpaid
     && Model.Payments.Any(p => p.Provider == PaymentProviders.BankTransfer))
{
    <p class="alert alert-info">
        @Icons.Svg("info")
        <span>
            We are waiting for your bank transfer. Quote <strong>@Model.OrderNo</strong> as the reference
            and email us the receipt — we will start the lab work as soon as it clears.
        </span>
    </p>
}

<div class="cart-layout">
    <div>
        <div class="section-head"><h2>What you ordered</h2></div>

        @foreach (var item in Model.Items)
        {
            <div class="cart-line order-line">
                <div class="cart-thumb">
                    @if (item.ImageSnapshot is not null)
                    {
                        <img src="@item.ImageSnapshot" alt="@item.TitleSnapshot" loading="lazy" />
                    }
                </div>
                <div>
                    <h3>@item.TitleSnapshot</h3>
                    <p class="cart-sku">@item.SkuSnapshot</p>
                    @if (item.LensSummary is not null)
                    {
                        <p class="cart-meta">@item.LensSummary</p>
                    }
                    <p class="cart-meta">Qty @item.Qty</p>
                    @if (item.PrescriptionId is not null)
                    {
                        <p class="mt-1">
                            <span class="chip chip-warn">Prescription awaiting verification</span>
                        </p>
                        <p class="hint">One of our opticians checks every prescription before the lenses are cut.</p>
                    }
                </div>
                <div class="cart-price">@M(item.TotalMinor)</div>
            </div>
        }

        <p class="mt-4">
            <a class="btn btn-outline" asp-controller="Frames" asp-action="Index">Keep shopping</a>
        </p>
    </div>

    <aside class="cart-aside">
        <div class="cart-summary">
            <h2>Totals</h2>
            <div class="totals-row"><span>Frames</span><span>@M(Model.SubtotalMinor)</span></div>
            @if (Model.LensTotalMinor > 0)
            {
                <div class="totals-row"><span>Lenses</span><span>@M(Model.LensTotalMinor)</span></div>
            }
            @if (Model.DiscountMinor > 0)
            {
                <div class="totals-row discount">
                    <span>Discount@(Model.PromoCode is not null ? $" ({Model.PromoCode})" : "")</span>
                    <span>&minus; @M(Model.DiscountMinor)</span>
                </div>
            }
            <div class="totals-row">
                <span>Delivery</span>
                <span>@(Model.ShippingMinor == 0 ? "Free" : M(Model.ShippingMinor))</span>
            </div>
            @if (Model.TaxMinor > 0)
            {
                <div class="totals-row"><span>Tax</span><span>@M(Model.TaxMinor)</span></div>
            }
            <div class="totals-row grand"><span>Total</span><span>@M(Model.TotalMinor)</span></div>
        </div>

        @if (Model.ShippingAddress is { } addr)
        {
            <div class="info-card">
                <h3>Delivery address</h3>
                <address>
                    @addr.FullName<br />
                    @addr.Line1<br />
                    @if (!string.IsNullOrWhiteSpace(addr.Line2))
                    {
                        @addr.Line2<br />
                    }
                    @addr.City@(string.IsNullOrWhiteSpace(addr.State) ? "" : ", " + addr.State)
                    @addr.PostalCode<br />
                    @addr.Country
                </address>
            </div>
        }

        @foreach (var shipment in Model.Shipments.Where(s => s.TrackingNumber is not null))
        {
            <div class="info-card">
                <h3>Tracking</h3>
                <p>
                    @shipment.Carrier.ToUpperInvariant() — @shipment.TrackingNumber
                    @if (shipment.TrackingUrl is not null)
                    {
                        <br />
                        <a href="@shipment.TrackingUrl" target="_blank" rel="noreferrer noopener">Track this parcel</a>
                    }
                </p>
            </div>
        }
    </aside>
</div>
