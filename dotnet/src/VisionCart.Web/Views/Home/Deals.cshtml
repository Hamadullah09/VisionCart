@using Microsoft.Extensions.Options
@model IReadOnlyList<Promotion>
@inject IOptions<StoreOptions> Store
@{
    ViewData["Title"] = "Deals";
    var store = Store.Value;
}

<div class="page-head">
    <div>
        <h1>Current offers</h1>
        <p>Everything on this page is live right now. Codes go in at checkout — the best one applies on its own if you forget.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Frames" asp-action="Index">Browse all frames</a>
</div>

@if (Model.Count == 0)
{
    <div class="shop-empty">
        <span class="shop-empty-art">@Icons.Svg("promos")</span>
        <h2>No offers running</h2>
        <p>There is nothing on at the moment. The frames are still worth a look, and delivery is tracked either way.</p>
        <div class="hero-actions">
            <a class="btn btn-primary" asp-controller="Frames" asp-action="Index">Browse all frames</a>
            <a class="btn btn-outline" href="/try-on">Try a pair on</a>
        </div>
    </div>
}
else
{
    <div class="grid grid-3">
        @foreach (var deal in Model)
        {
            @* Conditions are gathered first so the card can tell the difference
               between "no strings" and "we simply have not listed them". *@
            var terms = new List<string>();
            if (deal.MinSubtotalMinor > 0)
            {
                terms.Add($"Spend at least {Money.Format(deal.MinSubtotalMinor, store.Currency, store.CurrencySymbol)}");
            }
            if (deal.MinQty > 1) { terms.Add($"Buy {deal.MinQty} or more"); }
            if (deal.FirstOrderOnly) { terms.Add("First orders only"); }
            <article class="deal-card">
                <h3>@deal.Name</h3>
                <p>@(deal.Description ?? IPromotionService.Describe(deal))</p>

                @if (deal.Code is not null)
                {
                    <span class="deal-code">@deal.Code</span>
                }
                else
                {
                    <span class="deal-auto">@Icons.Svg("tick") Applied automatically</span>
                }

                @if (terms.Count > 0)
                {
                    <ul class="deal-terms">
                        @foreach (var term in terms)
                        {
                            <li>@term</li>
                        }
                    </ul>
                }

                @* A closing date is worth colouring; its absence is not. *@
                @if (deal.EndsAt is { } ends)
                {
                    <p class="deal-ends">@Icons.Svg("clock") Ends @ends.ToString("d MMMM yyyy")</p>
                }
                else
                {
                    <p class="deal-ends is-quiet">No closing date</p>
                }
            </article>
        }
    </div>

    <p class="muted small mt-4 prose">
        One offer applies per order — the best one you qualify for — unless a deal is marked
        as stackable, in which case it can ride alongside another.
    </p>
}
