@model IReadOnlyList<DataSubjectRequest>
@{
    ViewData["Title"] = "Your data";
}

<div class="page-head">
    <div>
        <h1>Your data</h1>
        <p>What we hold about you, and how to change it. Because we are an optical
    practice, some records — prescriptions and orders — have to be kept even when
    you ask us to erase your details.</p>
    </div>
</div>
<div class="panel">
    <h2>Download a copy</h2>
    <p>
        Everything we hold on your account: your details, addresses, orders,
        prescriptions and appointments, as a single file.
    </p>
    <a class="btn btn-primary" asp-action="Download">Download my data (JSON)</a>
</div>

<div class="panel">
    <h2>Ask us to change something</h2>
    <p>
        Correct a detail, restrict how we use your data, or ask us to erase you
        from our records.
    </p>
    <a class="btn btn-outline" asp-action="Raise">Make a request</a>
</div>

<h2>Your requests</h2>
@if (Model.Count == 0)
{
    <div class="shop-empty">
        <span class="shop-empty-art">@Icons.Svg("shield")</span>
        <h2>No requests yet</h2>
        <p>Any correction, restriction or erasure request you raise will be listed here with its progress.</p>
        <a class="btn btn-outline" asp-action="Raise">Make a request</a>
    </div>
}
else
{
    <table>
        <thead><tr><th>Request</th><th>Raised</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var request in Model)
        {
            <tr>
                <td>@(DataSubjectRequestKinds.Labels.TryGetValue(request.Kind, out var label) ? label : request.Kind)</td>
                <td>@request.CreatedAt.ToString("d MMM yyyy")</td>
                <td><span class="chip">@Humanise.Value(request.Status)</span></td>
            </tr>
        }
        </tbody>
    </table>
}
