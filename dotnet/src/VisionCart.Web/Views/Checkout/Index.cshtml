@using Microsoft.Extensions.Options
@model CheckoutViewModel
@inject IOptions<StoreOptions> Store
@{
    ViewData["Title"] = "Checkout";
    var store = Store.Value;
    string M(int minor) => Money.Format(minor, store.Currency, store.CurrencySymbol);
    var input = Model.Input;
}

<div class="page-head">
    <div>
        <h1>Checkout</h1>
        <p>Five short sections. Nothing is charged until the last one.</p>
    </div>
    <a class="btn btn-outline" asp-controller="Cart" asp-action="Index">Back to cart</a>
</div>

@if (User.Identity?.IsAuthenticated != true && Model.GuestAllowed)
{
    <p class="alert alert-info">
        @Icons.Svg("info")
        <span>Checking out as a guest. <a href="/login">Sign in</a> to reuse a saved prescription and track your order.</span>
    </p>
}

<div asp-validation-summary="All" class="alert alert-error" role="alert"></div>

<form method="post" asp-action="Place">
    <div class="checkout-layout">
        <div>
            <section class="checkout-section">
                <h2><span class="checkout-step" aria-hidden="true">1</span> Contact</h2>
                <div class="form-grid">
                    <div>
                        <label for="Email">Email <span class="req">*</span></label>
                        <input class="field" id="Email" name="Email" type="email" value="@input.Email"
                               autocomplete="email" required />
                        <p class="hint">Order updates and your prescription link go here.</p>
                    </div>
                    <div>
                        <label for="Phone">Phone <span class="req">*</span></label>
                        <input class="field" id="Phone" name="Phone" type="tel" value="@input.Phone"
                               autocomplete="tel" required />
                        <p class="hint">The courier calls before delivery.</p>
                    </div>
                </div>
            </section>

            <section class="checkout-section">
                <h2><span class="checkout-step" aria-hidden="true">2</span> Delivery address</h2>
                <div class="form-grid">
                    <div class="full">
                        <label for="FullName">Full name <span class="req">*</span></label>
                        <input class="field" id="FullName" name="FullName" value="@input.FullName"
                               autocomplete="name" required />
                    </div>
                    <div class="full">
                        <label for="Line1">Address <span class="req">*</span></label>
                        <input class="field" id="Line1" name="Line1" value="@input.Line1"
                               autocomplete="address-line1" required />
                    </div>
                    <div class="full">
                        <label for="Line2">Apartment, suite <span class="muted">(optional)</span></label>
                        <input class="field" id="Line2" name="Line2" value="@input.Line2"
                               autocomplete="address-line2" />
                    </div>
                    <div>
                        <label for="City">City <span class="req">*</span></label>
                        <input class="field" id="City" name="City" value="@input.City"
                               autocomplete="address-level2" required />
                    </div>
                    <div>
                        <label for="State">Province / state</label>
                        <input class="field" id="State" name="State" value="@input.State"
                               autocomplete="address-level1" />
                    </div>
                    <div>
                        <label for="PostalCode">Postal code</label>
                        <input class="field" id="PostalCode" name="PostalCode" value="@input.PostalCode"
                               autocomplete="postal-code" />
                    </div>
                    <div>
                        <label for="Country">Country</label>
                        <select id="Country" name="Country" autocomplete="country">
                            <option value="PK" selected="@(input.Country == "PK")">Pakistan</option>
                            <option value="AE" selected="@(input.Country == "AE")">United Arab Emirates</option>
                            <option value="GB" selected="@(input.Country == "GB")">United Kingdom</option>
                            <option value="US" selected="@(input.Country == "US")">United States</option>
                        </select>
                    </div>
                    <label class="checkline full">
                        <input type="checkbox" name="SaveAddress" value="true" checked="@input.SaveAddress" />
                        <span>Save this address for next time</span>
                    </label>
                </div>
            </section>

            <section class="checkout-section">
                <h2><span class="checkout-step" aria-hidden="true">3</span> Delivery method</h2>
                <div class="pay-options">
                    @foreach (var quote in Model.ShippingQuotes)
                    {
                        <label class="pay-option">
                            <input type="radio" name="ShippingCode" value="@quote.Code"
                                   checked="@(input.ShippingCode == quote.Code || (input.ShippingCode is null && quote == Model.ShippingQuotes[0]))" />
                            <span class="line-name">
                                <span class="name">@quote.Name</span>
                                <span class="desc">@quote.EtaText</span>
                            </span>
                            <span class="line-total">@(quote.PriceMinor == 0 ? "Free" : M(quote.PriceMinor))</span>
                        </label>
                    }
                </div>
            </section>

            <section class="checkout-section">
                <h2><span class="checkout-step" aria-hidden="true">4</span> Payment</h2>
                <div class="pay-options">
                    @foreach (var method in Model.PaymentMethods)
                    {
                        <label class="pay-option">
                            <input type="radio" name="PaymentMethod" value="@method.Id"
                                   checked="@(input.PaymentMethod == method.Id || (string.IsNullOrEmpty(input.PaymentMethod) && method == Model.PaymentMethods[0]))" required />
                            <span class="line-name">
                                <span class="name">@method.Label</span>
                                <span class="desc">@method.Description</span>
                            </span>
                        </label>
                    }
                </div>
            </section>

            <section class="checkout-section">
                <h2><span class="checkout-step" aria-hidden="true">5</span> Anything we should know?</h2>
                <label for="Notes">Notes <span class="muted">(optional)</span></label>
                <textarea class="field" id="Notes" name="Notes" rows="3"
                          placeholder="Delivery instructions, or details about your prescription.">@input.Notes</textarea>

                <button class="btn btn-primary btn-block btn-lg mt-3" type="submit">Place order</button>
                <p class="hint text-center">
                    By ordering you confirm the prescription details you gave us are current and correct.
                </p>
            </section>
        </div>

        <aside class="cart-aside">
            <div class="cart-summary">
                <h2>Your order</h2>

                @foreach (var line in Model.Cart.Lines)
                {
                    <div class="checkout-line">
                        <span class="qty-badge">@line.Qty</span>
                        <span class="line-name">
                            @line.Title
                            <span>@line.LensSummary</span>
                        </span>
                        <span class="line-total">@M(line.TotalMinor)</span>
                    </div>
                }

                <div class="totals-row mt-2">
                    <span>Frames</span><span>@M(Model.Cart.Totals.SubtotalMinor)</span>
                </div>
                @if (Model.Cart.Totals.LensTotalMinor > 0)
                {
                    <div class="totals-row"><span>Lenses</span><span>@M(Model.Cart.Totals.LensTotalMinor)</span></div>
                }
                @foreach (var promo in Model.Cart.Promotions)
                {
                    <div class="totals-row discount"><span>@promo.Name</span><span>&minus; @M(promo.DiscountMinor)</span></div>
                }
                <div class="totals-row">
                    <span>Delivery</span>
                    <span>@(Model.Cart.Totals.ShippingMinor == 0 ? "Free" : M(Model.Cart.Totals.ShippingMinor))</span>
                </div>
                @if (Model.Cart.Totals.TaxMinor > 0)
                {
                    <div class="totals-row"><span>Tax</span><span>@M(Model.Cart.Totals.TaxMinor)</span></div>
                }
                <div class="totals-row grand"><span>Total</span><span>@M(Model.Cart.Totals.TotalMinor)</span></div>

                <p class="cart-note">Delivery is recalculated from your address when you place the order.</p>
            </div>
        </aside>
    </div>
</form>
