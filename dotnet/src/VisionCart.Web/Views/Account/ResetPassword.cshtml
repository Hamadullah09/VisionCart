@model VisionCart.Web.Controllers.ResetPasswordInput
@{ ViewData["Title"] = "Set a new password"; }
<div style="max-width:420px;margin:40px auto;">
    <h1>Set a new password</h1>
    <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
    <form method="post">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <label asp-for="Password" class="small muted">New password</label>
        <input class="field" asp-for="Password" type="password" autocomplete="new-password" autofocus />
        <p class="small muted">At least 8 characters, with a digit and a lower-case letter.</p>
        <label asp-for="ConfirmPassword" class="small muted" style="margin-top:12px;display:block;">Confirm password</label>
        <input class="field" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        <button class="btn btn-primary btn-block" style="margin-top:16px;" type="submit">Save new password</button>
    </form>
</div>
