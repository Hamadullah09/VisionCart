@model VisionCart.Web.Controllers.ResetPasswordInput
@{ ViewData["Title"] = "Set a new password"; }

<div class="auth">
    <div class="auth-card">
        <span class="auth-mark">@Icons.Svg("shield")</span>
        <h1>Set a new password</h1>
        <p class="auth-lede">Choose something you have not used here before. Every other session will be signed out.</p>

        <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>

        <form method="post">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />
            <div class="auth-fields">
                <div>
                    <label asp-for="Password">New password</label>
                    <input class="field" asp-for="Password" type="password" autocomplete="new-password" autofocus />
                    <p class="hint">At least 8 characters, with a digit and a lower-case letter.</p>
                </div>
                <div>
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <input class="field" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                </div>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Save new password</button>
        </form>
    </div>
</div>
