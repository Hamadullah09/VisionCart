@model VisionCart.Web.Controllers.ForgotPasswordInput
@{ ViewData["Title"] = "Forgotten password"; }
<div style="max-width:420px;margin:40px auto;">
    <h1>Forgotten your password?</h1>
    <p class="muted small">
        Enter the email address on your account and we'll send you a link to set a new
        password. The link works once and expires in six hours.
    </p>
    <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
    <form method="post">
        <label asp-for="Email" class="small muted">Email</label>
        <input class="field" asp-for="Email" type="email" autocomplete="username" autofocus />
        <button class="btn btn-primary btn-block" style="margin-top:16px;" type="submit">Send the link</button>
    </form>
    <p class="small muted" style="margin-top:16px;"><a href="/login">Back to sign in</a></p>
</div>
