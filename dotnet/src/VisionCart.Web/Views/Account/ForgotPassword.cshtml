@model VisionCart.Web.Controllers.ForgotPasswordInput
@{ ViewData["Title"] = "Forgotten password"; }

<div class="auth">
    <div class="auth-card">
        <span class="auth-mark">@Icons.Svg("shield")</span>
        <h1>Forgotten your password?</h1>
        <p class="auth-lede">
            Enter the email address on your account and we will send you a link to set a new
            password. The link works once and expires in six hours.
        </p>

        <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>

        <form method="post">
            <div class="auth-fields">
                <div>
                    <label asp-for="Email">Email</label>
                    <input class="field" asp-for="Email" type="email" autocomplete="username" autofocus />
                </div>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Send the link</button>
        </form>

        <div class="auth-foot">
            <p><a href="/login">Back to sign in</a></p>
        </div>
    </div>
</div>
