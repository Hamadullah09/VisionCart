@{ ViewData["Title"] = "Check your email"; }
<div style="max-width:420px;margin:40px auto;">
    <h1>Check your email</h1>
    <p>If that address has an account with us, a reset link is on its way. It works once and expires in six hours.</p>
    <p class="small muted">Nothing arrived? Check your spam folder, then try again — and make sure you used the address you ordered with.</p>
    <p style="margin-top:20px;"><a class="btn btn-outline" href="/login">Back to sign in</a></p>
</div>
