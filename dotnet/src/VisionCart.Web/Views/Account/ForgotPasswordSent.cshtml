@{ ViewData["Title"] = "Check your email"; }

<div class="auth">
    <div class="auth-card">
        <span class="auth-mark is-ok">@Icons.Svg("inbox")</span>
        <h1>Check your email</h1>
        <p>If that address has an account with us, a reset link is on its way. It works once and expires in six hours.</p>
        <p class="auth-lede">
            Nothing arrived? Check your spam folder, then try again — and make sure you used
            the address you ordered with.
        </p>
        <a class="btn btn-outline btn-block" href="/login">Back to sign in</a>
    </div>
</div>
