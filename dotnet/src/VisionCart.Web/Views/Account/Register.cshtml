@model VisionCart.Web.Controllers.RegisterInput
@{ ViewData["Title"] = "Create an account"; }

<div class="auth">
    <div class="auth-card">
        <span class="auth-mark">@Icons.Svg("glasses")</span>
        <h1>Create an account</h1>
        <p class="auth-lede">An account keeps your prescription on file, so a repeat pair takes a minute.</p>

        <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="auth-fields">
                <div>
                    <label asp-for="Name">Your name</label>
                    <input class="field" asp-for="Name" autocomplete="name" autofocus />
                </div>
                <div>
                    <label asp-for="Email">Email</label>
                    <input class="field" asp-for="Email" type="email" autocomplete="username" />
                </div>
                <div>
                    <label asp-for="Phone">Phone <span class="muted">(optional)</span></label>
                    <input class="field" asp-for="Phone" type="tel" autocomplete="tel" />
                </div>
                <div>
                    <label asp-for="Password">Password</label>
                    <input class="field" asp-for="Password" type="password" autocomplete="new-password" />
                    <p class="hint">At least 8 characters, with a digit and a lower-case letter.</p>
                </div>
                <div>
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <input class="field" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                </div>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Create account</button>
        </form>

        <div class="auth-foot">
            <p>Already have one? <a asp-action="Login" asp-route-next="@Model.ReturnUrl">Sign in</a>.</p>
        </div>
    </div>
</div>
