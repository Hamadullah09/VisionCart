@{ ViewData["Title"] = "Password changed"; }

<div class="auth">
    <div class="auth-card">
        <span class="auth-mark is-ok">@Icons.Svg("tick")</span>
        <h1>Password changed</h1>
        <p>If that link was valid, your password has been updated and any other sessions have been signed out.</p>
        <a class="btn btn-primary btn-block" href="/login">Sign in</a>
    </div>
</div>
