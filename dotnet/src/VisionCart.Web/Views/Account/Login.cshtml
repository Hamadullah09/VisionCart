@model VisionCart.Web.Controllers.LoginInput
@{ ViewData["Title"] = "Sign in"; }

<div class="auth">
    <div class="auth-card">
        <span class="auth-mark">@Icons.Svg("glasses")</span>
        <h1>Sign in</h1>
        <p class="auth-lede">Your prescriptions, orders and saved addresses, all in one place.</p>

        <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="auth-fields">
                <div>
                    <label asp-for="Email">Email</label>
                    <input class="field" asp-for="Email" type="email" autocomplete="username" autofocus />
                </div>
                <div>
                    <label asp-for="Password">Password</label>
                    <input class="field" asp-for="Password" type="password" autocomplete="current-password" />
                </div>
                <label class="checkline">
                    <input asp-for="RememberMe" type="checkbox" />
                    <span>Keep me signed in</span>
                </label>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Sign in</button>
        </form>

        <div class="auth-foot">
            <p><a href="/forgot-password">Forgotten your password?</a></p>
            <p>No account yet? <a asp-action="Register" asp-route-next="@Model.ReturnUrl">Create one</a>.</p>
        </div>
    </div>
</div>
