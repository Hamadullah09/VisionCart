// VisionCart — prescription eyewear commerce platform
//
// Dev default is SQLite so the app runs with zero infrastructure.
// To move to Postgres/MySQL: change `provider` below and DATABASE_URL, then
// `npx prisma migrate dev`. The schema deliberately avoids enums, arrays and
// native Json so it is portable across all three engines without edits —
// constrained string fields are validated in src/lib/constants.ts instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// People & access
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?
  name         String
  passwordHash String?
  // ROLES: customer | staff | optician | admin  (see constants.ts)
  role         String    @default("customer")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient       Patient?
  addresses     Address[]
  orders        Order[]
  carts         Cart[]
  tryOnSessions TryOnSession[]
  auditLogs     AuditLog[]

  @@index([role])
}

/// Clinical + commercial record kept for the lifetime of the customer
/// relationship. One per person; prescriptions are versioned children so
/// historical Rx used on past orders is never overwritten.
model Patient {
  id          String    @id @default(cuid())
  // Human-friendly file number shown in the back office, e.g. P-000123
  fileNo      String    @unique
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  dateOfBirth DateTime?
  gender      String?
  // Free-text clinical context: allergies, prior surgery, dry-eye, etc.
  notes       String?
  // Measured or supplied interpupillary distance in mm (binocular)
  pdMm        Float?
  pdNearMm    Float?
  // Face measurements captured by the try-on tool, JSON string
  faceMetrics String?
  tags        String?

  // Consent & retention (keep explicit — this is health data)
  consentMarketing Boolean   @default(false)
  consentDataAt    DateTime?
  consentVersion   String?
  retentionUntil   DateTime?
  deletedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescriptions Prescription[]
  orders        Order[]
  appointments  Appointment[]
  documents     PatientDocument[]
  tryOnSessions TryOnSession[]

  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
}

/// One prescription version. Immutable once used on an order — the order line
/// stores its own snapshot as well, so re-issuing an Rx never rewrites history.
model Prescription {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // SOURCE: uploaded | in_store_exam | manual_entry | imported
  source      String    @default("manual_entry")
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime?
  prescriber  String?
  clinic      String?
  // Scan/photo of the paper Rx
  documentUrl String?
  verifiedBy  String?
  verifiedAt  DateTime?
  // STATUS: draft | pending_verification | verified | rejected | expired
  status      String    @default("draft")

  // Right eye (OD)
  odSphere      Float?
  odCylinder    Float?
  odAxis        Int?
  odAdd         Float?
  odPrism       Float?
  odPrismBase   String?
  odPdMm        Float?
  // Left eye (OS)
  osSphere      Float?
  osCylinder    Float?
  osAxis        Int?
  osAdd         Float?
  osPrism       Float?
  osPrismBase   String?
  osPdMm        Float?
  // Progressive / bifocal fitting heights
  odSegHeightMm Float?
  osSegHeightMm Float?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([patientId, issuedAt])
  @@index([status])
}

model PatientDocument {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // KIND: prescription_scan | id_document | insurance | photo | other
  kind      String   @default("other")
  label     String?
  url       String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([patientId])
}

model Appointment {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  minutes   Int      @default(30)
  // KIND: eye_test | fitting | collection | adjustment | follow_up
  kind      String   @default("eye_test")
  // STATUS: scheduled | completed | no_show | cancelled
  status    String   @default("scheduled")
  notes     String?
  createdAt DateTime @default(now())

  @@index([startsAt])
}

model Address {
  id         String  @id @default(cuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String  @default("PK")
  isDefault  Boolean @default(false)

  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Frame catalogue
// ---------------------------------------------------------------------------

model Brand {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  logoUrl  String?
  about    String?
  isActive Boolean @default(true)
  frames   Frame[]
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  position Int        @default(0)
  frames   FrameCategory[]
}

model FrameCategory {
  frameId    String
  categoryId String
  frame      Frame    @relation(fields: [frameId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([frameId, categoryId])
}

model Frame {
  id      String  @id @default(cuid())
  sku     String  @unique
  slug    String  @unique
  name    String
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  description String?
  // SHAPE: rectangle | square | round | oval | aviator | cat_eye | wayfarer | geometric | browline
  shape       String?
  // MATERIAL: acetate | metal | titanium | tr90 | stainless | mixed | wood
  material    String?
  // RIM: full_rim | semi_rimless | rimless
  rimType     String  @default("full_rim")
  // GENDER: men | women | unisex | kids
  gender      String  @default("unisex")
  // FACE SHAPES this frame flatters, comma separated: oval,round,square,heart,diamond,oblong
  faceShapes  String?

  // Standard eyewear sizing in millimetres  (e.g. 52 [] 18 - 140)
  lensWidthMm    Float?
  bridgeWidthMm  Float?
  templeLengthMm Float?
  lensHeightMm   Float?
  totalWidthMm   Float?
  weightGrams    Float?
  // SIZE BAND: narrow | medium | wide  — derived from totalWidthMm, used for filters
  sizeBand       String?

  // Money is stored in minor units (paisa/cents) to avoid float drift
  basePriceMinor    Int
  compareAtMinor    Int?
  costMinor         Int?
  // Frame can be bought without lenses (e.g. sunglasses / frame-only)
  allowFrameOnly    Boolean @default(true)
  requiresPrescription Boolean @default(false)

  // PUBLISH STATUS: draft | active | archived
  status     String   @default("draft")
  isFeatured Boolean  @default(false)
  position   Int      @default(0)
  metaTitle  String?
  metaDesc   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants   FrameVariant[]
  categories FrameCategory[]

  @@index([status, isFeatured])
  @@index([shape])
  @@index([brandId])
}

/// A colourway of a frame. Stock, images and the try-on overlay all hang here
/// because they are colour-specific.
model FrameVariant {
  id      String @id @default(cuid())
  frameId String
  frame   Frame  @relation(fields: [frameId], references: [id], onDelete: Cascade)

  sku        String  @unique
  colorName  String
  // Hex swatch shown in the colour picker
  colorHex   String?
  barcode    String?
  // Overrides the frame base price when set
  priceMinor Int?
  stockQty   Int     @default(0)
  lowStockAt Int     @default(3)
  isActive   Boolean @default(true)
  position   Int     @default(0)

  // --- Virtual try-on overlay calibration -------------------------------
  // A front-on PNG with transparency. The two anchors are the points in that
  // image where the wearer's pupils must land, expressed 0..1 of image size.
  // Everything else (scale, rotation, position) is solved from the detected
  // pupils, so a correctly anchored asset needs no per-face tuning.
  tryOnImageUrl   String?
  anchorLeftX     Float   @default(0.29)
  anchorLeftY     Float   @default(0.50)
  anchorRightX    Float   @default(0.71)
  anchorRightY    Float   @default(0.50)
  /// Multiplier applied after auto-fit, for assets with generous padding
  tryOnScaleAdj   Float   @default(1.0)
  /// Extra opacity for tinted/sunglass lenses drawn over the eyes
  tryOnOpacity    Float   @default(1.0)

  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  snapshots  TryOnSnapshot[]

  @@index([frameId, isActive])
}

model ProductImage {
  id        String       @id @default(cuid())
  variantId String
  variant   FrameVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  thumbUrl  String?
  alt       String?
  // ROLE: gallery | primary | try_on | swatch | lifestyle | 360
  role      String       @default("gallery")
  width     Int?
  height    Int?
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([variantId, position])
}

// ---------------------------------------------------------------------------
// Lenses & prescription pricing
// ---------------------------------------------------------------------------

/// A sellable lens configuration option. Grouped by `group` so the storefront
/// can render the lens builder as a sequence of steps without hard-coding it.
model LensOption {
  id    String @id @default(cuid())
  // GROUP: usage | type | index | coating | tint | extra
  group String
  code  String @unique
  name  String
  description String?
  priceMinor  Int    @default(0)
  // Only offered when the Rx falls inside this range (null = no limit)
  minSphere   Float?
  maxSphere   Float?
  maxCylinder Float?
  // Comma-separated codes of options this one requires / conflicts with
  requires    String?
  excludes    String?
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)
  position    Int     @default(0)

  @@index([group, position])
}

// ---------------------------------------------------------------------------
// Cart, orders, fulfilment
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  currency  String   @default("PKR")
  promoCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String       @id @default(cuid())
  cartId    String
  cart      Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   FrameVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int          @default(1)

  // Chosen lens option codes, comma separated; resolved at price time
  lensOptionCodes String?
  // Rx captured during checkout before a Patient record exists, JSON string
  prescriptionDraft String?
  prescriptionId    String?
  tryOnSnapshotId   String?

  unitPriceMinor Int @default(0)
  lensPriceMinor Int @default(0)

  createdAt DateTime @default(now())

  @@index([cartId])
}

model Order {
  id          String  @id @default(cuid())
  orderNo     String  @unique
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  email String
  phone String?

  // STATUS: pending | paid | in_lab | ready | shipped | delivered | cancelled | refunded
  status        String @default("pending")
  // PAYMENT STATUS: unpaid | authorized | paid | partially_refunded | refunded | failed
  paymentStatus String @default("unpaid")
  // FULFILMENT: unfulfilled | lab_processing | quality_check | packed | shipped | delivered
  fulfilmentStatus String @default("unfulfilled")

  currency         String @default("PKR")
  subtotalMinor    Int    @default(0)
  lensTotalMinor   Int    @default(0)
  discountMinor    Int    @default(0)
  shippingMinor    Int    @default(0)
  taxMinor         Int    @default(0)
  totalMinor       Int    @default(0)

  promoCode   String?
  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  shippingAddressId String?
  shippingAddress   Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddressId  String?
  billingAddress    Address? @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)

  notes         String?
  internalNotes String?
  placedAt      DateTime  @default(now())
  paidAt        DateTime?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?

  items     OrderItem[]
  payments  Payment[]
  shipments Shipment[]

  @@index([status, placedAt])
  @@index([email])
  @@index([patientId])
}

model OrderItem {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   FrameVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Denormalised so the invoice still reads correctly if the catalogue changes
  titleSnapshot String
  skuSnapshot   String
  imageSnapshot String?

  qty            Int @default(1)
  unitPriceMinor Int @default(0)
  lensPriceMinor Int @default(0)
  totalMinor     Int @default(0)

  lensOptionCodes    String?
  lensSummary        String?
  prescriptionId     String?
  prescription       Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  /// Full JSON copy of the Rx as it was at purchase time
  prescriptionSnapshot String?
  tryOnSnapshotUrl   String?

  // LAB STATUS: pending | ordered | surfacing | coating | glazing | qc | ready
  labStatus String  @default("pending")
  labRef    String?

  @@index([orderId])
}

model Payment {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // PROVIDER: stripe | cod | bank_transfer | manual
  provider String
  // STATUS: pending | authorized | succeeded | failed | refunded
  status   String @default("pending")
  amountMinor Int
  currency    String @default("PKR")
  providerRef String?
  /// Raw provider payload for reconciliation, JSON string
  rawPayload  String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([providerRef])
}

model Shipment {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // CARRIER: tcs | leopards | dhl | fedex | ups | local | other
  carrier  String
  service  String?
  trackingNumber String?
  trackingUrl    String?
  labelUrl       String?
  costMinor      Int      @default(0)
  // STATUS: pending | label_created | in_transit | out_for_delivery | delivered | returned
  status         String   @default("pending")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  providerRef    String?
  createdAt      DateTime @default(now())

  @@index([orderId])
}

model ShippingRate {
  id        String  @id @default(cuid())
  name      String
  country   String  @default("PK")
  region    String?
  // Applies when the order subtotal falls inside this window
  minSubtotalMinor Int  @default(0)
  maxSubtotalMinor Int?
  priceMinor       Int  @default(0)
  etaDaysMin       Int  @default(2)
  etaDaysMax       Int  @default(5)
  carrier          String?
  isActive         Boolean @default(true)
  position         Int     @default(0)
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

model Promotion {
  id          String  @id @default(cuid())
  name        String
  description String?
  /// Null = automatic promotion applied without a code
  code        String? @unique

  // KIND: percent_off | amount_off | free_shipping | bogo | free_lens_upgrade | bundle
  kind        String
  /// Percent as basis points (1500 = 15%) or minor units for amount_off
  value       Int     @default(0)
  maxDiscountMinor Int?

  // Conditions
  minSubtotalMinor Int      @default(0)
  minQty           Int      @default(1)
  /// Comma-separated ids; empty = whole catalogue
  brandIds         String?
  categoryIds      String?
  frameIds         String?
  /// Restrict to first-time buyers
  firstOrderOnly   Boolean  @default(false)

  startsAt  DateTime?
  endsAt    DateTime?
  usageLimit       Int?
  usageLimitPerUser Int?
  usageCount       Int     @default(0)
  stackable        Boolean @default(false)
  priority         Int     @default(0)
  isActive         Boolean @default(true)

  /// Storefront banner copy, so marketing can ship a deal without a deploy
  bannerText  String?
  bannerColor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive, startsAt, endsAt])
}

// ---------------------------------------------------------------------------
// Virtual try-on
// ---------------------------------------------------------------------------

model TryOnSession {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  // SOURCE: upload | camera
  source    String   @default("upload")
  photoUrl  String?
  /// Detected landmark summary + estimated PD, JSON string
  faceData  String?
  createdAt DateTime @default(now())

  snapshots TryOnSnapshot[]

  @@index([userId])
}

model TryOnSnapshot {
  id        String       @id @default(cuid())
  sessionId String
  session   TryOnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  variantId String
  variant   FrameVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imageUrl  String
  createdAt DateTime     @default(now())

  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

/// Key/value store config editable from the admin UI, so the shop can be
/// re-branded and re-priced without touching env files or redeploying.
model Setting {
  key       String   @id
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  thumbUrl  String?
  filename  String
  mimeType  String?
  sizeBytes Int?
  width     Int?
  height    Int?
  /// Free tagging so the bulk uploader can group a shoot
  tags      String?
  uploadedBy String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Record of every CSV/bulk import so a bad file can be traced and rolled back
model ImportJob {
  id        String   @id @default(cuid())
  kind      String
  filename  String
  // STATUS: pending | running | completed | failed
  status    String   @default("pending")
  totalRows Int      @default(0)
  okRows    Int      @default(0)
  errorRows Int      @default(0)
  /// Row-level errors, JSON string
  report    String?
  createdBy String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId String?
  /// Before/after diff, JSON string
  detail   String?
  ip       String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
